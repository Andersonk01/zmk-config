/*
 * Metade ESQUERDA — teclado independente (Corne Esquerda).
 * Colunas 0–5 do layout; colunas 6–11 = &none.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// | TAB | Q | W | E | R | T |
// | CTRL| A | S | D | F | G |
// | SHFT| Z | X | C | V | B |
//       | GUI | LWR | SPC |
            bindings = <
    &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &none &none &none &none &none &none
    &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &none &none &none &none &none &none
    &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &none &none &none &none &none &none
                      &kp LGUI &mo 1 &kp SPACE   &none &none &none
            >;
        };

        bt_layer {
            display-name = "Bluetooth";
// | TAB | 1 | 2 | 3 | 4 | 5 |
// |BTCLR|BT1|BT2|BT3|BT4|BT5|
// | SHFT|   |   |   |   |   |
//       | GUI |     | SPC |
            bindings = <
    &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &none &none &none &none &none &none
    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &none
    &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &none &none &none &none &none &none
                            &kp LGUI     &mo 2        &kp SPACE      &none &none &none
            >;
        };

        raise_layer {
            display-name = "Simbolos";
            bindings = <
    &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &none &none &none &none &none &none
    &kp LCTRL &trans   &trans &trans   &trans   &trans      &none &none &none &none &none &none
    &kp LSHFT &trans   &trans &trans   &trans   &trans      &none &none &none &none &none &none
                      &kp LGUI &trans   &kp SPACE   &none &none &none
            >;
        };
    };
};
