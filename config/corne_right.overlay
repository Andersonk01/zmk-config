/*
 * Metade DIREITA — standalone (sem split).
 * Redefine o matrix transform para 6 colunas × 4 rows.
 * Colunas INVERTIDAS (5→0) porque o PCB é espelhado (flipped).
 * Thumb keys nas colunas 3, 4, 5 (também invertidos).
 * Mesmos pinos de coluna que a esquerda (clone PCB).
 */

#include <dt-bindings/zmk/matrix_transform.h>

&default_transform {
    col-offset = <0>;
    columns = <6>;
    rows = <4>;
    map = <
        RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
        RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
        RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
                        RC(3,5) RC(3,4) RC(3,3)
    >;
};

&five_column_transform {
    col-offset = <0>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 21 GPIO_ACTIVE_HIGH>
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>
        ;
};
