/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Layout de Programação para Corne Keyboard
 * ==========================================
 * Layer 0: Base QWERTY
 * Layer 1: Símbolos + Números
 * Layer 2: Navegação (Vim-style)
 * Layer 3: Numpad
 * Layer 4: Sistema / Hardware (F-keys, Mídia, Bluetooth)
 * Layer 5: Mouse
 * Layer 6: Macros de Desenvolvimento
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        // Hold-tap: Toque = Space, Segura = Alt
        alt_spc: alt_space {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_SPACE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Hold-tap: Toque = Enter, Segura = Layer 2
        ent_l2: enter_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_LAYER2";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // Macro: Arrow Function () => {}
        arrow_fn: arrow_function {
            compatible = "zmk,behavior-macro";
            label = "ARROW_FUNCTION";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: console.log()
        cons_log: console_log {
            compatible = "zmk,behavior-macro";
            label = "CONSOLE_LOG";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp L &kp O &kp G &kp LPAR &kp RPAR>;
        };

        // Macro: Comentário de bloco /* */
        comment_blk: comment_block {
            compatible = "zmk,behavior-macro";
            label = "COMMENT_BLOCK";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp FSLH &kp ASTRK &kp SPACE &kp SPACE &kp ASTRK &kp FSLH &kp LEFT &kp LEFT &kp LEFT>;
        };

        // =====================================================================
        // Macros React
        // =====================================================================
        
        // Macro: export const Component = () => {}
        export_const: export_const {
            compatible = "zmk,behavior-macro";
            label = "EXPORT_CONST";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp E &kp X &kp P &kp O &kp R &kp T &kp SPACE &kp C &kp O &kp N &kp S &kp T &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp N &kp E &kp N &kp T &kp SPACE &kp EQUAL &kp SPACE &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: const [state, setState] = useState();
        useState: useState {
            compatible = "zmk,behavior-macro";
            label = "USE_STATE";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp O &kp N &kp S &kp T &kp SPACE &kp LBKT &kp S &kp T &kp A &kp T &kp E &kp COMMA &kp SPACE &kp S &kp E &kp T &kp S &kp T &kp A &kp T &kp E &kp RBKT &kp SPACE &kp EQUAL &kp SPACE &kp U &kp S &kp E &kp S &kp T &kp A &kp T &kp E &kp LPAR &kp RPAR &kp SEMI>;
        };

        // Macro: useEffect(() => {}, []);
        useEffect: useEffect {
            compatible = "zmk,behavior-macro";
            label = "USE_EFFECT";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp U &kp S &kp E &kp E &kp F &kp F &kp E &kp C &kp T &kp LPAR &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp COMMA &kp SPACE &kp LBKT &kp RBKT &kp RPAR &kp SEMI>;
        };

        // Macro: export default function Component() {}
        export_fn: export_function {
            compatible = "zmk,behavior-macro";
            label = "EXPORT_FUNCTION";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp E &kp X &kp P &kp O &kp R &kp T &kp SPACE &kp D &kp E &kp F &kp A &kp U &kp L &kp T &kp SPACE &kp F &kp U &kp N &kp C &kp T &kp I &kp O &kp N &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp N &kp E &kp N &kp T &kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
        };

        // =====================================================================
        // Macros JavaScript/TypeScript
        // =====================================================================

        // Macro: async () => {}
        async_fn: async_function {
            compatible = "zmk,behavior-macro";
            label = "ASYNC_FUNCTION";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp A &kp S &kp Y &kp N &kp C &kp SPACE &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: try {} catch (e) {}
        try_catch: try_catch {
            compatible = "zmk,behavior-macro";
            label = "TRY_CATCH";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp T &kp R &kp Y &kp SPACE &kp LBRC &kp RBRC &kp SPACE &kp C &kp A &kp T &kp C &kp H &kp SPACE &kp LPAR &kp E &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: return
        return_macro: return_macro {
            compatible = "zmk,behavior-macro";
            label = "RETURN";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp R &kp E &kp T &kp U &kp R &kp N>;
        };

        // =====================================================================
        // Macros Git
        // =====================================================================

        // Macro: git status
        git_status: git_status {
            compatible = "zmk,behavior-macro";
            label = "GIT_STATUS";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp S &kp T &kp A &kp T &kp U &kp S &kp RET>;
        };

        // Macro: git commit -m ""
        git_commit: git_commit {
            compatible = "zmk,behavior-macro";
            label = "GIT_COMMIT";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp C &kp O &kp M &kp M &kp I &kp T &kp SPACE &kp MINUS &kp M &kp SPACE &kp SQT &kp SQT &kp LEFT>;
        };

        // Macro: git add .
        git_add_all: git_add_all {
            compatible = "zmk,behavior-macro";
            label = "GIT_ADD_ALL";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp A &kp D &kp D &kp SPACE &kp DOT &kp RET>;
        };

        // Macro: git push
        git_push: git_push {
            compatible = "zmk,behavior-macro";
            label = "GIT_PUSH";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp S &kp H &kp RET>;
        };

        // =====================================================================
        // Macros Docker
        // =====================================================================

        // Macro: docker compose up -d
        dc_up: docker_compose_up {
            compatible = "zmk,behavior-macro";
            label = "DC_UP";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp S &kp E &kp SPACE &kp U &kp P &kp SPACE &kp MINUS &kp D &kp RET>;
        };

        // Macro: docker compose down
        dc_down: docker_compose_down {
            compatible = "zmk,behavior-macro";
            label = "DC_DOWN";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp S &kp E &kp SPACE &kp D &kp O &kp W &kp N &kp RET>;
        };

        // Macro: docker compose build
        dc_build: docker_compose_build {
            compatible = "zmk,behavior-macro";
            label = "DC_BUILD";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp S &kp E &kp SPACE &kp B &kp U &kp I &kp L &kp D &kp RET>;
        };

        // =====================================================================
        // Macros Terminal / Package Managers
        // =====================================================================

        // Macro: pnpm dev
        pnpm_dev: pnpm_dev {
            compatible = "zmk,behavior-macro";
            label = "PNPM_DEV";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp P &kp N &kp P &kp M &kp SPACE &kp D &kp E &kp V &kp RET>;
        };

        // Macro: pnpm build
        pnpm_build: pnpm_build {
            compatible = "zmk,behavior-macro";
            label = "PNPM_BUILD";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp P &kp N &kp P &kp M &kp SPACE &kp B &kp U &kp I &kp L &kp D &kp RET>;
        };

        // Macro: TODO comment
        todo_macro: todo_macro {
            compatible = "zmk,behavior-macro";
            label = "TODO";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp FSLH &kp FSLH &kp SPACE &kp T &kp O &kp D &kp O &kp COLON &kp SPACE>;
        };

        // Macro: useMemo(() => {}, []);
        useMemo: useMemo {
            compatible = "zmk,behavior-macro";
            label = "USE_MEMO";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp U &kp S &kp E &kp M &kp E &kp M &kp O &kp LPAR &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp COMMA &kp SPACE &kp LBKT &kp RBKT &kp RPAR &kp SEMI>;
        };

        // Macro: useCallback(() => {}, []);
        useCallback: useCallback {
            compatible = "zmk,behavior-macro";
            label = "USE_CALLBACK";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp U &kp S &kp E &kp C &kp A &kp L &kp L &kp B &kp A &kp C &kp K &kp LPAR &kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp COMMA &kp SPACE &kp LBKT &kp RBKT &kp RPAR &kp SEMI>;
        };

        // Macro: if () {}
        ifBlock: if_block {
            compatible = "zmk,behavior-macro";
            label = "IF_BLOCK";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp I &kp F &kp SPACE &kp LPAR &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: condition ? true : false
        ternary: ternary {
            compatible = "zmk,behavior-macro";
            label = "TERNARY";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp SPACE &kp QMARK &kp SPACE &kp T &kp R &kp U &kp E &kp SPACE &kp COLON &kp SPACE &kp F &kp A &kp L &kp S &kp E>;
        };

        // Macro: for (const x of y) {}
        forOf: for_of {
            compatible = "zmk,behavior-macro";
            label = "FOR_OF";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp F &kp O &kp R &kp SPACE &kp LPAR &kp C &kp O &kp N &kp S &kp T &kp SPACE &kp X &kp SPACE &kp O &kp F &kp SPACE &kp Y &kp RPAR &kp SPACE &kp LBRC &kp RBRC>;
        };

        // Macro: .map(item => {})
        mapFn: map_function {
            compatible = "zmk,behavior-macro";
            label = "MAP_FUNCTION";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DOT &kp M &kp A &kp P &kp LPAR &kp I &kp T &kp E &kp M &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp RPAR>;
        };

        // Macro: .filter(item => {})
        filterFn: filter_function {
            compatible = "zmk,behavior-macro";
            label = "FILTER_FUNCTION";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp DOT &kp F &kp I &kp L &kp T &kp E &kp R &kp LPAR &kp I &kp T &kp E &kp M &kp SPACE &kp EQUAL &kp GT &kp SPACE &kp LBRC &kp RBRC &kp RPAR>;
        };

        // Macro: git pull
        git_pull: git_pull {
            compatible = "zmk,behavior-macro";
            label = "GIT_PULL";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp L &kp L &kp RET>;
        };

        // Macro: git checkout -b
        git_checkout_b: git_checkout_b {
            compatible = "zmk,behavior-macro";
            label = "GIT_CHECKOUT_B";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp C &kp H &kp E &kp C &kp K &kp O &kp U &kp T &kp SPACE &kp MINUS &kp B &kp SPACE>;
        };

        // Macro: git log --oneline --graph
        git_log: git_log {
            compatible = "zmk,behavior-macro";
            label = "GIT_LOG";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp L &kp O &kp G &kp SPACE &kp MINUS &kp MINUS &kp O &kp N &kp E &kp L &kp I &kp N &kp E &kp SPACE &kp MINUS &kp MINUS &kp G &kp R &kp A &kp P &kp H &kp RET>;
        };

        // Macro: git diff
        git_diff: git_diff {
            compatible = "zmk,behavior-macro";
            label = "GIT_DIFF";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp D &kp I &kp F &kp F &kp RET>;
        };

        // Macro: docker compose logs -f
        dc_logs: docker_compose_logs {
            compatible = "zmk,behavior-macro";
            label = "DC_LOGS";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp C &kp O &kp M &kp P &kp O &kp S &kp E &kp SPACE &kp L &kp O &kp G &kp S &kp SPACE &kp MINUS &kp F &kp RET>;
        };

        // Macro: docker ps
        docker_ps: docker_ps {
            compatible = "zmk,behavior-macro";
            label = "DOCKER_PS";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp P &kp S &kp RET>;
        };

        // Macro: docker exec -it
        docker_exec: docker_exec {
            compatible = "zmk,behavior-macro";
            label = "DOCKER_EXEC";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp D &kp O &kp C &kp K &kp E &kp R &kp SPACE &kp E &kp X &kp E &kp C &kp SPACE &kp MINUS &kp I &kp T &kp SPACE>;
        };

        // Macro: npm run dev
        npm_dev: npm_dev {
            compatible = "zmk,behavior-macro";
            label = "NPM_DEV";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp N &kp P &kp M &kp SPACE &kp R &kp U &kp N &kp SPACE &kp D &kp E &kp V &kp RET>;
        };

        // Macro: npm run build
        npm_build: npm_build {
            compatible = "zmk,behavior-macro";
            label = "NPM_BUILD";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp N &kp P &kp M &kp SPACE &kp R &kp U &kp N &kp SPACE &kp B &kp U &kp I &kp L &kp D &kp RET>;
        };

        // Macro: pnpm test
        pnpm_test: pnpm_test {
            compatible = "zmk,behavior-macro";
            label = "PNPM_TEST";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp P &kp N &kp P &kp M &kp SPACE &kp T &kp E &kp S &kp T &kp RET>;
        };

        // Macro: clear
        clear_term: clear_terminal {
            compatible = "zmk,behavior-macro";
            label = "CLEAR";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp L &kp E &kp A &kp R &kp RET>;
        };

        // Macro: // FIXME:
        fixme_macro: fixme_macro {
            compatible = "zmk,behavior-macro";
            label = "FIXME";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp FSLH &kp FSLH &kp SPACE &kp F &kp I &kp X &kp M &kp E &kp COLON &kp SPACE>;
        };

        // Macro: console.error()
        console_err: console_error {
            compatible = "zmk,behavior-macro";
            label = "CONSOLE_ERROR";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp E &kp R &kp R &kp O &kp R &kp LPAR &kp RPAR>;
        };

        // Macro: throw new Error()
        throw_err: throw_error {
            compatible = "zmk,behavior-macro";
            label = "THROW_ERROR";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp T &kp H &kp R &kp O &kp W &kp SPACE &kp N &kp E &kp W &kp SPACE &kp E &kp R &kp R &kp O &kp R &kp LPAR &kp RPAR &kp SEMI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Combo: Ctrl+C (Copy) - Pressiona C + V juntos
        combo_copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 28>;  // C + V
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+V (Paste) - Pressiona V + B juntos
        combo_paste {
            bindings = <&kp LC(V)>;
            key-positions = <28 29>;  // V + B
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+Z (Undo) - Pressiona Z + X juntos
        combo_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;  // Z + X
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+Y (Redo) - Pressiona X + C juntos
        combo_redo {
            bindings = <&kp LC(Y)>;
            key-positions = <26 27>;  // X + C
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+S (Save) - Pressiona S + D juntos
        combo_save {
            bindings = <&kp LC(S)>;
            key-positions = <14 15>;  // S + D
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+A (Select All) - Pressiona A + S juntos
        combo_select_all {
            bindings = <&kp LC(A)>;
            key-positions = <13 14>;  // A + S
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+/ (Comment Line - VS Code) - Pressiona Q + W juntos
        combo_comment {
            bindings = <&kp LC(FSLH)>;
            key-positions = <1 2>;  // Q + W
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: Ctrl+F (Find) - Pressiona F + G juntos
        combo_find {
            bindings = <&kp LC(F)>;
            key-positions = <16 17>;  // F + G
            timeout-ms = <50>;
            layers = <0>;
        };

        // Combo: ESC rápido - Pressiona J + K juntos
        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <19 20>;  // J + K
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // Layer 0: Base QWERTY
        // =====================================================================
        default_layer {
            display-name = "Base";
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                    | GUI | L1  |ALT/SPC|   |ENT/L2| BSPC| L3  |
            bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
            &kp LGUI &mo 1 &alt_spc LALT SPACE   &ent_l2 2 RET &kp BSPC &tog 3
            >;
        };

        // =====================================================================
        // Layer 1: Símbolos e Números (Programação)
        // =====================================================================
        symbols_layer {
            display-name = "Symbols";
// -----------------------------------------------------------------------------------------
// |  `   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
// |      |  1  |  2  |  3  |  4  |  5  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// |      |  6  |  7  |  8  |  9  |  0  |   |  _  |  +  |  {  |  }  |  |  |  ~   |
//                    |     |     |     |   |     |     | L4  |
            bindings = <
   &kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp DEL
   &trans    &kp N1   &kp N2 &kp N3   &kp N4   &kp N5      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &trans    &kp N6   &kp N7 &kp N8   &kp N9   &kp N0      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &trans   &trans   &trans      &trans    &trans    &tog 4
            >;
        };

        // =====================================================================
        // Layer 2: Navegação (Vim-style HJKL)
        // =====================================================================
        navigation_layer {
            display-name = "Nav";
// -----------------------------------------------------------------------------------------
// | ESC  |     |     |     |     |     |   |     | HOME| PGDN| PGUP| END |      |
// |      |     |     |     |     |     |   | LEFT| DOWN|  UP |RIGHT|     |      |
// |      |UNDO |CUT  |COPY |PASTE|     |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
            bindings = <
   &kp ESC &trans    &trans    &trans    &trans    &trans      &trans   &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans
   &trans  &trans    &trans    &trans    &trans    &trans      &kp LEFT &kp DOWN &kp UP    &kp RIGHT &trans    &trans
   &trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &trans      &trans   &trans   &trans    &trans    &trans    &trans
                               &trans    &trans    &trans      &trans   &trans   &tog 5
            >;
        };

        // =====================================================================
        // Layer 3: Numpad
        // =====================================================================
        numpad_layer {
            display-name = "Numpad";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |  /  |  7  |  8  |  9  |  -  |      |
// |      |     |     |     |     |     |   |  *  |  4  |  5  |  6  |  +  |      |
// |      |     |     |     |     |     |   |  0  |  1  |  2  |  3  |  .  | ENT  |
//                    |     | L0  |     |   |     |     |     |
            bindings = <
   &trans &trans &trans &trans &trans &trans   &kp FSLH &kp N7 &kp N8 &kp N9 &kp MINUS &trans
   &trans &trans &trans &trans &trans &trans   &kp ASTRK &kp N4 &kp N5 &kp N6 &kp PLUS &trans
   &trans &trans &trans &trans &trans &trans   &kp N0   &kp N1 &kp N2 &kp N3 &kp DOT  &kp RET
                        &trans &to 0  &trans   &trans   &trans &trans
            >;
        };

        // =====================================================================
        // Layer 4: Sistema / Hardware (F-keys, Mídia, Bluetooth)
        // =====================================================================
        fkeys_layer {
            display-name = "System";
// -----------------------------------------------------------------------------------------
// |  F1  |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8 |  F9 | F10 | F11 | F12  |
// |      |PREV |NEXT |VOL- |VOL+ |PLAY |   |     |     |     |     |     | L6   |
// |BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |   |     |     |     |     |     | L0   |
//                    |     |     |     |   |     |     |     |
            bindings = <
   &kp F1     &kp F2       &kp F3       &kp F4       &kp F5       &kp F6         &kp F7     &kp F8    &kp F9      &kp F10 &kp F11 &kp F12
   &trans     &kp C_PREV   &kp C_NEXT   &kp C_VOL_DN &kp C_VOL_UP &kp C_PP       &trans     &trans    &trans      &trans  &trans  &tog 6
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans     &trans    &trans      &trans  &trans  &to 0
                                        &trans       &trans       &trans         &trans     &trans    &trans
            >;
        };

        // =====================================================================
        // Layer 5: Mouse
        // =====================================================================
        mouse_layer {
            display-name = "Mouse";
// -----------------------------------------------------------------------------------------
// |      |     |     |     |     |     |   |     |     |     |     |     |      |
// |      |     |     |     |     |     |   | M_L | M_D | M_U | M_R |     |      |
// |      |     |     |     |     |     |   |LCLK |MCLK |RCLK |SC_U |SC_D | L0   |
//                    |     |     |     |   |     |     |     |
            bindings = <
   &trans &trans &trans &trans &trans &trans   &trans          &trans          &trans          &trans           &trans          &trans
   &trans &trans &trans &trans &trans &trans   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans          &trans
   &trans &trans &trans &trans &trans &trans   &mkp LCLK       &mkp MCLK       &mkp RCLK       &msc SCRL_UP     &msc SCRL_DOWN  &to 0
                        &trans &trans &trans   &trans          &trans          &trans
            >;
        };

        // =====================================================================
        // Layer 6: Macros de Desenvolvimento
        // =====================================================================
        macros_layer {
            display-name = "Macros";
// -----------------------------------------------------------------------------------------
// |React |React|React|React|React|React|   |JS/TS|JS/TS|JS/TS|JS/TS|JS/TS|JS/TS |
// |Git   |Git  |Git  |Git  |Git |Git |   |Dock |Dock |Dock |Dock |Dock |Dock  |
// |Term  |Term |Term |Term |Term|Term|   |Util |Util |Util |Util |Util |Util  |
//                    |     |     |     |   |     |     |     |
            bindings = <
   &useState &useEffect &export_const &export_fn &useMemo &useCallback   &async_fn &try_catch &arrow_fn &return_macro &ifBlock &ternary
   &git_status &git_commit &git_add_all &git_push &git_pull &git_checkout_b   &dc_up &dc_down &dc_build &dc_logs &docker_ps &docker_exec
   &pnpm_dev &pnpm_build &pnpm_test &npm_dev &npm_build &clear_term   &cons_log &todo_macro &comment_blk &fixme_macro &console_err &throw_err
                        &trans &trans &trans   &trans &trans &to 0
            >;
        };
    };
};
